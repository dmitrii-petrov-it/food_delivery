<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.food_delivery.controllers.CouriersController" spacing="18.0" styleClass="orders-page">
    <HBox alignment="CENTER_LEFT" spacing="18.0">
        <VBox spacing="4.0">
            <Label text="Couriers" styleClass="page-title" />
            <Label text="Manage active delivery staff and transport" styleClass="page-subtitle" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="↩  Back to Main Menu" onAction="#onBackToMainMenu" styleClass="ghost-button" />
        <Button text="+  Add Courier" onAction="#onCourierAdd" styleClass="primary-cta-button" />
    </HBox>

    <FlowPane hgap="16.0" vgap="16.0" prefWrapLength="980.0" styleClass="stats-grid">
        <VBox styleClass="metric-card metric-card-total">
            <Region styleClass="metric-accent-bar" />
            <Label text="TOTAL COURIERS" styleClass="metric-title" />
            <Label fx:id="totalCouriersLabel" text="0" styleClass="metric-value" />
            <Label text="Full delivery team" styleClass="metric-caption" />
        </VBox>
        <VBox styleClass="metric-card metric-card-done">
            <Region styleClass="metric-accent-bar" />
            <Label text="AVAILABLE" styleClass="metric-title" />
            <Label fx:id="availableCouriersLabel" text="0" styleClass="metric-value" />
            <Label text="Ready to assign" styleClass="metric-caption" />
        </VBox>
        <VBox styleClass="metric-card metric-card-cancelled">
            <Region styleClass="metric-accent-bar" />
            <Label text="BUSY / INACTIVE" styleClass="metric-title" />
            <Label fx:id="busyInactiveCouriersLabel" text="0" styleClass="metric-value" />
            <Label text="Need attention" styleClass="metric-caption" />
        </VBox>
    </FlowPane>

    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="table-filter-row">
        <TextField fx:id="courierSearchField" promptText="🔍   Search by courier name or phone..." styleClass="toolbar-search-field" HBox.hgrow="ALWAYS" />
        <ComboBox fx:id="courierStatusFilterBox" promptText="All Statuses" styleClass="toolbar-filter-box" />
        <ComboBox fx:id="courierVehicleFilterBox" promptText="All Vehicles" styleClass="toolbar-date-box" />
        <TextField fx:id="courierExtraFilterField" promptText="Vehicle or status" styleClass="toolbar-date-box" />
        <Button text="Reset" onAction="#onCourierRefresh" styleClass="ghost-button" />
    </HBox>

    <BorderPane styleClass="orders-table-shell" VBox.vgrow="ALWAYS">
        <center>
            <TableView fx:id="courierTable" prefHeight="420.0" styleClass="orders-table">
                <columns>
                    <TableColumn fx:id="courierIdColumn" text="№" prefWidth="70.0" />
                    <TableColumn fx:id="courierNameColumn" text="FULL NAME" prefWidth="240.0" />
                    <TableColumn fx:id="courierPhoneColumn" text="PHONE" prefWidth="160.0" />
                    <TableColumn fx:id="courierVehicleColumn" text="VEHICLE" prefWidth="150.0" />
                    <TableColumn fx:id="courierStatusColumn" text="STATUS" prefWidth="150.0" />
                    <TableColumn fx:id="courierActionsColumn" text="ACTIONS" prefWidth="130.0" />
                </columns>
            </TableView>
        </center>
    </BorderPane>
</VBox>
